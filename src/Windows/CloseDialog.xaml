<Window x:Class="RTMPProjector.Windows.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close RTMP Projector"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="24,20,24,24">

        <TextBlock Text="What would you like to do?"
                   Foreground="{DynamicResource TextPrim}"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Text="RTMP Projector will keep running in the background if you minimise it to the system tray."
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <Button Content="Minimise to System Tray"
                Click="MinimiseToTray_Click"
                Style="{StaticResource BaseBtn}"
                HorizontalAlignment="Stretch"
                Padding="0,10"
                Margin="0,0,0,8"/>

        <Button Content="Quit RTMP Projector"
                Click="Quit_Click"
                Style="{StaticResource DangerBtn}"
                HorizontalAlignment="Stretch"
                Padding="0,10"
                Margin="0,0,0,8"/>

        <Button Content="Cancel"
                Click="Cancel_Click"
                Style="{StaticResource GhostBtn}"
                HorizontalAlignment="Stretch"
                Padding="0,10"/>

    </StackPanel>
</Window>
