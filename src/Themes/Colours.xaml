<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App colour palette (light theme only) -->
    <SolidColorBrush x:Key="BgDeep"     Color="#f5f5f7"/>
    <SolidColorBrush x:Key="BgPanel"    Color="#ffffff"/>
    <SolidColorBrush x:Key="BgCard"     Color="#ffffff"/>
    <SolidColorBrush x:Key="BgInput"    Color="#efeff4"/>
    <SolidColorBrush x:Key="BgHover"    Color="#e6e6f0"/>

    <!-- Light purple for buttons, selections and borders (dark text sits on top) -->
    <SolidColorBrush x:Key="Accent"     Color="#b4bcfb"/>
    <SolidColorBrush x:Key="AccentHot"  Color="#9fa9f9"/>
    <!-- Purple used for text on white (the URL, logo) — darker so it stays readable -->
    <SolidColorBrush x:Key="AccentText" Color="#6f78ee"/>

    <SolidColorBrush x:Key="Success"    Color="#27ae60"/>
    <SolidColorBrush x:Key="Danger"     Color="#e74c3c"/>
    <SolidColorBrush x:Key="TextPrim"   Color="#1a1a2e"/>
    <SolidColorBrush x:Key="TextMuted"  Color="#6b7280"/>
    <SolidColorBrush x:Key="Border"     Color="#d1d5db"/>

</ResourceDictionary>
